# Server-only OpenAI configuration
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-sol
OPENAI_RECHECK_MODEL=gpt-5.6-sol

# Optional PostgreSQL. The demo UI runs without it; durable production writes do not.
DATABASE_URL=

# Local-only corpus processing
LOCAL_CORPUS_ENABLED=false
CORPUS_DIR=pdffirma
SPT_MAX_PAGES_PER_RUN=8
SPT_MAX_IMAGES_PER_REQUEST=1
SPT_MAX_CONCURRENT_REQUESTS=2
SPT_MAX_OUTPUT_TOKENS=12000
SPT_MAX_ESTIMATED_COST_USD=5
DECISION_PERSISTENCE_MODE=LEGACY_LOCAL
ENABLE_PROJECT_CALCULATION=false
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/smart_procurement
